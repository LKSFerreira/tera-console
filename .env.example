# Cópia para .env e preencha (o .env NÃO vai para o git)

# Gemini (recomendado para tradução de patch notes)
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI=
# ou:
# GEMINI_API_KEY=
# Modelo default: gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash
# Alternativa barata: gemini-3.1-flash-lite

# Opcionais
# DEEPL_AUTH_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# LOCALIZE_PROVIDER=gemini
