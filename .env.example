# Copie para .env e preencha (o arquivo .env NÃO vai para o git)

# Google AI Studio: https://aistudio.google.com/apikey
# Nome canônico da chave Gemini (use este no GitHub Secrets também)
GEMINI_API_KEY=

# Modelo de tradução (default se omitido: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash
# Alternativa mais barata: gemini-3.1-flash-lite

# Opcionais
# DEEPL_AUTH_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# LOCALIZE_PROVIDER=gemini
