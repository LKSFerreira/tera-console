# Copie para .env e preencha (o arquivo .env NÃO vai para o git)

# --- Tradução (ordem de escolha do provedor primário) ---
# 1) GEMINI_API_KEY  2) OPENROUTER_API_KEY  3) DEEPL  4) OPENAI/XAI  5) --translate (MyMemory)

# Google AI Studio: https://aistudio.google.com/apikey
# Nome canônico da chave Gemini (use este no GitHub Secrets também)
GEMINI_API_KEY=

# Modelo Gemini (default se omitido: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash
# Alternativa mais barata: gemini-3.1-flash-lite

# OpenRouter — fallback FREE quando Gemini falha (cota, 429, rede, etc.)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default recomendado para patch notes (qualidade + throughput free):
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Opcionais (ranking OpenRouter):
# OPENROUTER_SITE_URL=https://github.com/LKSFerreira/tera-console
# OPENROUTER_APP_NAME=tera-console-portal-localize

# Opcionais
# DEEPL_AUTH_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# LOCALIZE_PROVIDER=gemini
# LOCALIZE_PROVIDER=openrouter
