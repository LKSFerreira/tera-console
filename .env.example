# Copie para .env (nao commitar). Cadeia MT: Strategy em scripts/lib/traducao/

# --- Cadeia de provedores (fallback automatico) ---
# Ordem padrao: gemini → openrouter → groq → deepl → openai → xai
# LOCALIZE_CHAIN=gemini,openrouter,groq,deepl
# Forcar um so (sem fallback): LOCALIZE_PROVIDER=groq
# Cadeia explicita: LOCALIZE_PROVIDER=cadeia

# 1) Gemini (primario tipico)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# 2) OpenRouter free (ex. apos 429 Gemini)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=tera-console-portal-localize

# 3) Groq free-tier (qualidade: llama-3.3-70b-versatile)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 4) DeepL / OpenAI / xAI
# DEEPL_AUTH_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# XAI_API_KEY=
